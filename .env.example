# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres service (docker-compose.yml)
POSTGRES_USER=expense_tracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=expense_tracker

# App database URL (async driver) — host is the docker-compose service name
DATABASE_URL=postgresql+asyncpg://expense_tracker:change-me@db:5432/expense_tracker

# JWT auth (HS256, 24h expiration per spec Clarifications 2026-09-03)
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
